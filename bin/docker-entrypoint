#!/bin/bash -e

# Enable jemalloc for reduced memory usage and latency.
if [ -z "${LD_PRELOAD+x}" ]; then
    LD_PRELOAD=$(find /usr/lib -name libjemalloc.so.2 -print -quit)
    export LD_PRELOAD
fi

# Migrate on boot only when not on Fly (Fly runs db:prepare via release_command).
# Skipping here lets Puma bind immediately so health checks can pass.
if [ -z "${FLY_APP_NAME}" ] && [ "${1}" == "./bin/rails" ] && [ "${2}" == "server" ]; then
  ./bin/rails db:prepare
fi

exec "${@}"
