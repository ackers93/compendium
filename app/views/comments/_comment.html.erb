<% depth = local_assigns.fetch(:depth, 0) %>
<% children_by_parent = local_assigns.fetch(:children_by_parent, {}) %>
<% page_verse = local_assigns[:page_verse] %>
<% child_comments = children_by_parent[comment.id] || [] %>

<div id="<%= dom_id(comment) %>" class="comment-thread<%= ' comment-reply' if depth > 0 %>">
  <%= render 'comments/comment_body',
      comment: comment,
      page_verse: page_verse,
      depth: depth,
      has_replies: child_comments.any? %>

  <div id="<%= dom_id(comment, :replies) %>" class="comment-replies">
    <% child_comments.each do |reply| %>
      <%= render 'comments/comment',
            comment: reply,
            children_by_parent: children_by_parent,
            page_verse: page_verse,
            depth: depth + 1 %>
    <% end %>
  </div>
</div>
