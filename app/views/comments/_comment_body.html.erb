<% depth = local_assigns.fetch(:depth, 0) %>
<% page_verse = local_assigns[:page_verse] %>

<div id="<%= dom_id(comment, :body) %>" class="comment-item<%= ' comment-item--nested' if depth > 0 %>">
  <div class="comment-header text-xs text-gray-500 mb-1">
    <span class="author-name">
      <%= comment.user&.display_name || "Unknown User" %>
    </span>
    <span class="comment-date">
      • <%= time_ago_in_words(comment.created_at) %> ago
    </span>
    <% if comment.commentable.is_a?(BibleVerse) && comment.range? %>
      <span class="comment-range">
        • on <%= comment.verse_reference %>
      </span>
    <% end %>
    <% if current_user %>
      <span class="ml-2 comment-actions-inline">
        <% reply_path = new_comment_reply_path_for(comment, page_commentable: page_verse || comment.commentable) %>
        <% if current_user.can_create? && reply_path && depth < Comment::MAX_DEPTH %>
          <%= link_to "Reply", reply_path,
              class: "text-blue-500 hover:text-blue-700",
              data: { turbo_frame: "modal" } %>
          <span class="mx-1">•</span>
        <% end %>
        <% if current_user.can_edit?(comment) %>
          <%= link_to "Edit", edit_comment_path(comment), 
              class: "text-blue-500 hover:text-blue-700",
              data: { turbo_frame: "modal" } %>
          <span class="mx-1">•</span>
        <% end %>
        <% if current_user.can_delete?(comment) %>
          <% delete_params = if page_verse
               { book: page_verse.book, chapter: page_verse.chapter, verse_number: page_verse.verse }
             else
               {}
             end %>
          <%= link_to "Delete", comment_path(comment, delete_params), 
              class: "text-red-500 hover:text-red-700",
              data: { turbo_method: :delete, turbo_confirm: depth > 0 || local_assigns[:has_replies] ? "Delete this comment and all its replies?" : "Are you sure?" } %>
        <% else %>
          <%= link_to "Flag", "javascript:void(0)", 
              onclick: "flagContent('Comment', #{comment.id})",
              class: "text-yellow-600 hover:text-yellow-800" %>
        <% end %>
      </span>
    <% end %>
  </div>
  
  <div class="comment-content">
    <%= comment.content %>
  </div>
</div>
