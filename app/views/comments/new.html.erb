<%= turbo_frame_tag "modal" do %>
  <div class="modal-overlay" data-controller="modal">
    <div class="modal modal-md" data-modal-target="modal">
      <div class="modal-header">
        <h2 class="modal-title">Add Comment</h2>
        <%= link_to "×", "#", class: "modal-close", data: { action: "click->modal#closeModal" } %>
      </div>

      <div class="modal-body">
        <% if @commentable.is_a?(BibleVerse) %>
          <p class="text-sm text-gray-600 mb-4">
            <%= @commentable.book %> <%= @commentable.chapter %>:<%= @commentable.verse %>
          </p>
        <% end %>
        <%= render 'comments/form', comment: @comment %>
      </div>

      <div class="modal-footer">
        <%= link_to 'Cancel', "#", class: 'btn btn-outline', data: { action: "click->modal#closeModal" } %>
      </div>
    </div>
  </div>
<% end %>
