<% roots, children_by_parent = Comment.thread_for(commentable) %>
<% page_verse = commentable.is_a?(BibleVerse) ? commentable : nil %>

<% if roots.any? %>
  <% roots.each do |comment| %>
    <%= render 'comments/comment',
          comment: comment,
          children_by_parent: children_by_parent,
          page_verse: page_verse,
          depth: 0 %>
  <% end %>
<% else %>
  <div class="text-center py-8 text-gray-500">
    <p>No comments yet. Be the first to share your thoughts!</p>
  </div>
<% end %>
