<div class="page-header">
  <h1 class="page-title">Edit User Role</h1>
  <p class="page-subtitle">Change role and permissions for <%= @user.email %></p>
</div>

<div class="content-section" style="max-width: 800px; margin: 0 auto;">
  <div class="edit-user-card">
    <div class="user-info-section">
      <h2 class="section-title">
        <i class="fa-solid fa-user"></i>
        User Information
      </h2>
      <div class="info-grid">
        <div class="info-item">
          <span class="info-label">Email</span>
          <span class="info-value"><%= @user.email %></span>
        </div>
        <div class="info-item">
          <span class="info-label">Name</span>
          <span class="info-value"><%= @user.name || 'Not provided' %></span>
        </div>
        <div class="info-item">
          <span class="info-label">Current Role</span>
          <span class="info-value">
            <span class="role-badge <%= @user.role %>">
              <%= @user.role&.titleize || 'Viewer' %>
            </span>
          </span>
        </div>
        <div class="info-item">
          <span class="info-label">Member Since</span>
          <span class="info-value"><%= @user.created_at.strftime("%B %d, %Y") %></span>
        </div>
        <div class="info-item">
          <span class="info-label">Contributor Agreement</span>
          <span class="info-value">
            <% if @user.accepted_contributor_agreement? %>
              <span class="agreement-status agreement-status-accepted">
                <i class="fa-solid fa-circle-check"></i>
                Accepted <%= @user.contributor_agreement_accepted_at.strftime("%b %d, %Y") %>
              </span>
            <% else %>
              <span class="agreement-status agreement-status-pending">
                <i class="fa-solid fa-circle-exclamation"></i>
                Not accepted — promotion blocked
              </span>
            <% end %>
          </span>
        </div>
      </div>
    </div>
    
    <%= form_with(model: [:admin, @user], local: true, class: "edit-role-form") do |form| %>
      <div class="form-section">
        <h2 class="section-title">
          <i class="fa-solid fa-user-shield"></i>
          Change Role
        </h2>

        <% unless @user.eligible_for_contributor_promotion? %>
          <div class="alert alert-warning mb-4">
            <p class="mb-0">
              This user has not accepted the Contributor Agreement. They can accept it from
              their Profile or during onboarding. Until then, they can only remain a Viewer.
            </p>
          </div>
        <% end %>
        
        <div class="form-group">
          <%= form.label :role, "Select New Role", class: "form-label" %>
          <div class="role-select-wrapper">
            <% role_options = [['Viewer - Can only view content', 'viewer']] %>
            <% if @user.eligible_for_contributor_promotion? || @user.role_contributor? || @user.role_admin? %>
              <% role_options << ['Contributor - Can create and manage their own content', 'contributor'] %>
              <% role_options << ['Admin - Can manage all content and users', 'admin'] %>
            <% end %>
            <%= form.select :role, 
                options_for_select(role_options, @user.role),
                {},
                class: "form-select" %>
          </div>
        </div>
        
        <div class="permissions-info">
          <div class="info-icon">
            <i class="fa-solid fa-circle-info"></i>
          </div>
          <div class="info-content">
            <h3 class="info-title">Role Permissions</h3>
            <ul class="permissions-list">
              <li>
                <span class="role-badge viewer">Viewer</span>
                <span>Can only view content</span>
              </li>
              <li>
                <span class="role-badge contributor">Contributor</span>
                <span>Can create, edit, and delete their own notes, comments, and cross-references</span>
              </li>
              <li>
                <span class="role-badge admin">Admin</span>
                <span>Full access to all content and user management</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
      
      <div class="form-actions">
        <%= link_to admin_users_path, class: "btn btn-secondary" do %>
          <i class="fa-solid fa-arrow-left"></i>
          Cancel
        <% end %>
        <%= form.submit "Update Role", class: "btn btn-primary" do %>
          <i class="fa-solid fa-save"></i>
          Update Role
        <% end %>
      </div>
    <% end %>
  </div>
</div>

