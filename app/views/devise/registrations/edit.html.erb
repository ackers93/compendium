<div class="page-header">
  <div class="text-center">
    <div class="icon-container mb-4">
      <i class="fa-solid fa-user-edit text-4xl text-primary"></i>
    </div>
    <h1 class="page-title">Edit Account</h1>
    <p class="page-subtitle">Update your profile information</p>
  </div>
</div>

<div class="content-section">
  <div class="section-header">
    <h2 class="section-title">Profile Information</h2>
  </div>
  
  <div class="section-content">
    <div class="form-container">
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: 'space-y-6' }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>
        
        <div class="form-group">
          <%= f.label :email, class: "form-label" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control" %>
        </div>

        <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
          <div class="alert alert-info">
            <p class="text-sm text-gray-700">
              Currently waiting confirmation for: <strong><%= resource.unconfirmed_email %></strong>
            </p>
          </div>
        <% end %>

        <div class="form-group">
          <%= f.label :password, class: "form-label" %>
          <small class="text-sm text-gray-600">(leave blank if you don't want to change it)</small>
          <%= f.password_field :password, autocomplete: "new-password", class: "form-control" %>
          <% if @minimum_password_length %>
            <small class="text-xs text-gray-500 mt-1 block"><%= @minimum_password_length %> characters minimum</small>
          <% end %>
        </div>

        <div class="form-group">
          <%= f.label :password_confirmation, class: "form-label" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control" %>
        </div>

        <div class="form-group">
          <%= f.label :current_password, class: "form-label" %>
          <small class="text-sm text-gray-600">(we need your current password to confirm your changes)</small>
          <%= f.password_field :current_password, autocomplete: "current-password", class: "form-control" %>
        </div>

        <div class="form-actions">
          <%= f.submit "Update Account", class: "btn btn-primary w-full" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<div class="content-section mt-8">
  <div class="section-header">
    <h2 class="section-title">Contributor Agreement</h2>
  </div>

  <div class="section-content">
    <% if current_user.accepted_contributor_agreement? %>
      <div class="content-surface">
        <p class="text-sm text-gray-600 mb-0">
          <span class="agreement-status agreement-status-accepted">
            <i class="fa-solid fa-circle-check"></i>
            Accepted <%= current_user.contributor_agreement_accepted_at.strftime("%B %d, %Y") %>
          </span>
        </p>
        <p class="text-sm text-gray-600 mt-3 mb-0">
          Admins can promote your account to Contributor. Thank you for agreeing to help keep Compendium helpful and kind.
        </p>
      </div>
    <% else %>
      <div class="content-surface" data-controller="contributor-agreement">
        <p class="text-sm text-gray-600 mb-4">
          Accepting this agreement notifies an administrator that you're ready for Contributor access.
          Until you accept, you can browse as a Viewer but cannot be promoted.
        </p>

        <ol class="onboarding-agreement-list mb-4">
          <% User::CONTRIBUTOR_AGREEMENT_TERMS.each do |term| %>
            <li class="onboarding-agreement-item">
              <strong><%= term[:title] %></strong>
              <span><%= term[:body] %></span>
            </li>
          <% end %>
        </ol>

        <%= form_with url: contributor_agreement_path, method: :post do %>
          <label class="onboarding-agreement-check mb-4">
            <input type="checkbox"
                   name="accept_contributor_agreement"
                   value="1"
                   required
                   data-contributor-agreement-target="checkbox"
                   data-action="change->contributor-agreement#sync">
            <span>I have read and agree to the Contributor Agreement</span>
          </label>

          <%= button_tag type: "submit",
                class: "btn btn-primary",
                disabled: true,
                data: { contributor_agreement_target: "submit" } do %>
            <i class="fa-solid fa-file-signature"></i>
            Accept Agreement
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<div class="content-section mt-8">
  <div class="section-header">
    <h2 class="section-title">Style</h2>
  </div>

  <div class="section-content">
    <div class="content-surface">
      <p class="theme-form-intro text-sm text-gray-600 mb-6">
        Customize accent, header, text, background, and the repeating colors used for
        multi-verse comment ranges and chiasm layers. Changes preview live; save to keep them.
      </p>

      <% theme = current_user.resolved_theme %>
      <div data-controller="theme-form">
        <%= form_with url: users_theme_path, method: :patch, class: "theme-form", data: { turbo: false } do %>
          <div class="theme-fields">
            <% Themeable::THEME_KEYS.each do |key| %>
              <% value = theme[key] %>
              <div class="theme-field">
                <label class="form-label" for="theme_<%= key %>_hex">
                  <%= Themeable::THEME_LABELS[key] %>
                </label>
                <div class="theme-field-controls">
                  <span class="theme-swatch"
                        data-theme-form-target="swatch"
                        data-theme-key="<%= key %>"
                        style="background-color: <%= value %>"></span>
                  <input type="color"
                         value="<%= value %>"
                         class="theme-color-picker"
                         data-theme-form-target="picker"
                         data-theme-key="<%= key %>"
                         data-action="input->theme-form#preview"
                         aria-label="<%= Themeable::THEME_LABELS[key] %> color picker">
                  <input type="text"
                         id="theme_<%= key %>_hex"
                         name="theme[<%= key %>]"
                         value="<%= value %>"
                         class="form-control theme-hex-input"
                         maxlength="7"
                         pattern="^#?[0-9A-Fa-f]{3}([0-9A-Fa-f]{3})?$"
                         placeholder="#be9627"
                         data-theme-form-target="hex"
                         data-theme-key="<%= key %>"
                         data-action="input->theme-form#preview"
                         autocomplete="off">
                </div>
              </div>
            <% end %>
          </div>

          <div class="theme-form-actions form-actions">
            <%= submit_tag "Save Style", class: "btn btn-primary" %>
          </div>
        <% end %>

        <div class="theme-form-reset mt-3">
          <%= button_to "Reset to Defaults", users_theme_path, method: :delete,
                class: "btn btn-outline",
                data: { turbo: false, confirm: "Reset your colors to the default forest theme?" } %>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="content-section mt-8">
  <div class="section-header">
    <h2 class="section-title">Security Settings</h2>
  </div>
  
  <div class="section-content">
    <div class="security-settings p-6 bg-blue-50 border border-blue-200 rounded-lg">
      <div class="flex items-start justify-between">
        <div class="flex-1">
          <h3 class="text-lg font-semibold text-blue-900 mb-2 flex items-center">
            <i class="fa-solid fa-shield-halved mr-2"></i>
            Two-Factor Authentication (2FA)
          </h3>
          <p class="text-blue-800 mb-4">
            Add an extra layer of security to your account. When enabled, you'll receive a verification code via email each time you sign in.
          </p>
          
          <div class="flex items-center gap-4">
            <div class="text-sm">
              Status: 
              <% if current_user.otp_required_for_login? %>
                <span class="badge bg-success text-white px-3 py-1 rounded">
                  <i class="fa-solid fa-check mr-1"></i> Enabled
                </span>
              <% else %>
                <span class="badge bg-warning text-dark px-3 py-1 rounded">
                  <i class="fa-solid fa-times mr-1"></i> Disabled
                </span>
              <% end %>
            </div>
          </div>
        </div>
        
        <div class="ml-4">
          <%= form_with url: users_two_factor_settings_path, method: :patch, data: { turbo: false } do |f| %>
            <%= hidden_field_tag :enabled, !current_user.otp_required_for_login? %>
            <% if current_user.otp_required_for_login? %>
              <%= f.submit "Disable 2FA", class: "btn btn-outline-danger", 
                  data: { confirm: "Are you sure you want to disable two-factor authentication?" } %>
            <% else %>
              <%= f.submit "Enable 2FA", class: "btn btn-primary" %>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="content-section mt-8">
  <div class="section-header">
    <h2 class="section-title text-red-600">Danger Zone</h2>
  </div>
  
  <div class="section-content">
    <div class="danger-zone p-6 bg-red-50 border border-red-200 rounded-lg">
      <h3 class="text-lg font-semibold text-red-800 mb-3">Cancel my account</h3>
      <p class="text-red-700 mb-4">
        Unhappy with your experience? You can cancel your account at any time.
        <strong>This action cannot be undone.</strong>
      </p>
      
      <div class="d-flex gap-3">
        <%= link_to "Cancel my account", registration_path(resource_name), 
            data: { confirm: "Are you sure? This action cannot be undone." }, 
            method: :delete, 
            class: "btn btn-danger" %>
        <%= link_to "Back", :back, class: "btn btn-outline" %>
      </div>
    </div>
  </div>
</div>
