<div class="page-header">
  <h1 class="page-title">Bulk Upload <%= @kind == "thread" ? "Thread" : "Topic" %></h1>
  <p class="page-subtitle">Create a <%= @kind == "thread" ? "thread" : "topic" %> from a list of verses, then add notes on the next page</p>
</div>

<div class="content-section">
  <div class="section-content">
    <div class="bulk-upload-help">
      <p>Enter a title and paste verse references separated by commas. Supported formats:</p>
      <ul>
        <li><code>gen1:2, 2Chron3:4, Gal2:5</code></li>
        <li><code>Genesis 1:1, John 3:16-18</code></li>
      </ul>
    </div>

    <%= form_with url: bulk_topic_thread_path, method: :post, class: "bulk-simple-form" do %>
      <fieldset class="bulk-kind-toggle">
        <legend class="form-label">Create a</legend>
        <div class="bulk-kind-options">
          <label class="bulk-kind-option">
            <%= radio_button_tag :kind, "topic", @kind == "topic" %>
            Topic
          </label>
          <label class="bulk-kind-option">
            <%= radio_button_tag :kind, "thread", @kind == "thread" %>
            Thread
          </label>
        </div>
      </fieldset>

      <div class="form-group">
        <%= label_tag :title, @kind == "thread" ? "Thread title" : "Topic name", class: "form-label" %>
        <%= text_field_tag :title, @title, class: "form-input", placeholder: @kind == "thread" ? "e.g. Salvation Through Faith" : "e.g. Creation", required: true %>
      </div>

      <div class="form-group">
        <%= label_tag :verse_refs, "Verses", class: "form-label" %>
        <%= text_area_tag :verse_refs, @verse_refs, class: "form-textarea bulk-verse-refs-input", rows: 5, placeholder: "gen1:2, 2Chron3:4, Gal2:5", required: true %>
        <p class="form-help">Separate references with commas, semicolons, or new lines.</p>
      </div>

      <% if @errors.present? %>
        <div class="alert alert-error mb-4">
          <% @errors.each do |error| %>
            <div><%= error %></div>
          <% end %>
        </div>
      <% end %>

      <div class="bulk-upload-actions">
        <div class="bulk-upload-submit">
          <% if @kind == "thread" %>
            <%= link_to "Back to Threads", bible_threads_path, class: "btn btn-outline" %>
          <% else %>
            <%= link_to "Back to Topics", topics_path, class: "btn btn-outline" %>
          <% end %>
          <%= submit_tag "Create and add notes", class: "btn btn-primary" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
