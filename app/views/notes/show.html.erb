<%= link_to notes_path, class: "btn btn-secondary" do %>
  <i class="fa-solid fa-arrow-left"></i>
  Back to Notes
<% end %>
<%= render 'note_content', note: @note %>

<div class="content-section mt-8">
  <div class="section-header">
    <h2 class="section-title">Comments</h2>
    <div id="comment-count">
      <%= render 'comments/comment_count', commentable: @note %>
    </div>
  </div>
  
  <div class="section-content">
    <div id="comments" class="comments-list">
      <%= render 'comments/comments_list', commentable: @note %>
    </div>
    
    <% if current_user&.can_create? %>
      <div class="content-surface mt-6">
        <h3 class="text-lg font-semibold mb-4">Add a comment</h3>
        <%= render 'comments/form', comment: @comment, page_commentable: @note %>
      </div>
    <% end %>
  </div>
</div>

<%= turbo_frame_tag "modal" %>
