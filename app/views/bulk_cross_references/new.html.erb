<div class="page-header">
  <h1 class="page-title">Bulk Upload Cross References</h1>
  <p class="page-subtitle">Link multiple pairs of verses at once</p>
</div>

<div class="content-section">
  <div class="section-content">
    <div class="bulk-upload-help">
      <p>Enter a source verse and target verse on each row. Comments are optional. Supported formats:</p>
      <ul>
        <li><code>gen1:1</code>, <code>Gen 1:1</code>, or <code>Genesis 1:1</code></li>
        <li>Target ranges: <code>john3:16-18</code> (source must be a single verse)</li>
      </ul>
    </div>

    <%= form_with url: bulk_cross_reference_path, method: :post, class: "bulk-xref-form", data: { controller: "bulk-upload" } do %>
      <div class="bulk-xref-list" data-bulk-upload-target="rows">
        <% @rows.each_with_index do |row, index| %>
          <%= render "bulk_cross_references/row", index: index, row: row %>
        <% end %>
      </div>

      <template data-bulk-upload-target="template">
        <%= render "bulk_cross_references/row", index: "__INDEX__", row: { source_reference: "", target_reference: "", content: "" } %>
      </template>

      <div class="bulk-upload-actions">
        <button type="button" class="btn btn-outline" data-action="bulk-upload#addRow">
          Add row
        </button>
        <div class="bulk-upload-submit">
          <%= link_to "Bulk comment upload", new_bulk_upload_path, class: "btn btn-outline" %>
          <%= link_to "Back to Bible", bible_verses_books_path, class: "btn btn-outline" %>
          <%= submit_tag "Upload cross references", class: "btn btn-primary" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
