<%# Compact preview shown inside the Trix editor attachment chrome %>
<figure class="content-table-trix-preview">
  <div class="content-table-trix-preview-icon">
    <i class="fa-solid fa-table"></i>
  </div>
  <figcaption class="content-table-trix-preview-caption">
    <strong><%= content_table.title %></strong>
    <span><%= content_table.row_count %>×<%= content_table.column_count %> table</span>
  </figcaption>
</figure>
