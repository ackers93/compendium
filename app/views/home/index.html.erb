<div class="hero-section">
  <div class="hero-overlay"></div>
  <div class="hero-content">
    <h1 class="hero-title">Christadelphian Compendium</h1>

    <hr class="hero-divider">

    <p class="hero-subtitle">
      A crowd-sourced community for studying Scripture together
    </p>

    <div class="hero-cta">
      <%= link_to bible_verses_books_path, class: "btn btn-primary btn-lg" do %>
        <i class="fa-solid fa-book-open"></i>
        Explore the Bible
      <% end %>
      <%= link_to notes_path, class: "btn btn-outline btn-lg" do %>
        <i class="fa-solid fa-sticky-note"></i>
        Browse Notes
      <% end %>
    </div>
  </div>
</div>

<div class="features-section">
  <div class="features-intro">
    <h2 class="section-title">Working with our Ecclesial family to build a knowledge base, to help with daily readings, writing classes and personal study.</h2>
    <p class="section-subtitle">
      Crowd-sourced Notes, Comments and Connections.
    </p>
  </div>

  <div class="feature-showcases">
    <% @features.each_with_index do |feature, index| %>
      <section class="feature-showcase<%= " feature-showcase--reverse" if index.odd? %>">
        <div class="feature-showcase-copy">
          <h3 class="feature-showcase-title"><%= feature[:title] %></h3>
          <p class="feature-showcase-body"><%= feature[:body] %></p>
          <%= link_to feature[:path], class: "feature-showcase-cta" do %>
            <%= feature[:cta] %>
            <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
          <% end %>
        </div>
        <div class="feature-showcase-media">
          <%= image_tag feature[:image],
                alt: "#{feature[:title]} screenshot",
                class: "feature-showcase-image" %>
        </div>
      </section>
    <% end %>
  </div>

  <% unless user_signed_in? %>
    <div class="home-join">
      <h2 class="home-join-title">Join the community</h2>
      <p class="home-join-body">
        Sign up to read, explore, and contribute as you grow in study with others.
      </p>
      <div class="home-join-actions">
        <%= link_to "Sign Up", new_user_registration_path, class: "btn btn-primary btn-lg" %>
        <%= link_to "Log In", new_user_session_path, class: "btn btn-outline btn-lg" %>
      </div>
    </div>
  <% end %>
</div>
