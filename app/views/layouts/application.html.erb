<!DOCTYPE html>
<html>
  <head>
    <title>Compendium</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "trix", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload" %>
    <%= theme_style_tag %>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Source+Serif+4:opsz,wght@8..60,600;8..60,700&display=swap" rel="stylesheet">
    <link rel="icon" type="image/png" href="<%= image_path("favicon/favicon-96x96.png") %>" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="<%= image_path("favicon/favicon.svg") %>" />
    <link rel="shortcut icon" href="<%= image_path("favicon/favicon.ico") %>" />
    <link rel="apple-touch-icon" sizes="180x180" href="<%= image_path("favicon/apple-touch-icon.png") %>" />
    <meta name="apple-mobile-web-app-title" content="Compendium" />
    <link rel="manifest" href="<%= image_path("favicon/site.webmanifest") %>" />
    <script>
      // Global function for flagging content
      function flagContent(contentType, contentId) {
        const reason = prompt("Please explain why you are flagging this content:");
        if (reason && reason.trim() !== '') {
          // Submit the flag via a simple form
          const form = document.createElement('form');
          form.method = 'POST';
          form.action = '/content_flags';
          
          // Add CSRF token
          const csrfToken = document.querySelector('meta[name="csrf-token"]').content;
          const csrfInput = document.createElement('input');
          csrfInput.type = 'hidden';
          csrfInput.name = 'authenticity_token';
          csrfInput.value = csrfToken;
          form.appendChild(csrfInput);
          
          // Add content type ID
          const idInput = document.createElement('input');
          idInput.type = 'hidden';
          if (contentType === 'Note') {
            idInput.name = 'note_id';
          } else if (contentType === 'Comment') {
            idInput.name = 'comment_id';
          } else if (contentType === 'CrossReference') {
            idInput.name = 'cross_reference_id';
          } else if (contentType === 'BibleThread') {
            idInput.name = 'bible_thread_id';
          } else if (contentType === 'Chiasm') {
            idInput.name = 'chiasm_id';
          }
          idInput.value = contentId;
          form.appendChild(idInput);
          
          // Add reason
          const reasonInput = document.createElement('input');
          reasonInput.type = 'hidden';
          reasonInput.name = 'content_flag[reason]';
          reasonInput.value = reason;
          form.appendChild(reasonInput);
          
          document.body.appendChild(form);
          form.submit();
        }
      }
    </script>
  </head>

  <body>
    <nav class="navbar" data-controller="mobile-nav">
      <div class="nav-container">
        <a href="/" class="nav-brand">
          <%= image_tag "logo.png", alt: "Compendium", class: "brand-logo" %>
        </a>
        
        <!-- Desktop Navigation -->
        <ul class="nav-menu nav-menu-desktop">
          <% if user_signed_in? %>
            <li class="nav-item">
              <div class="nav-dropdown" data-controller="dropdown">
                <button type="button"
                        class="nav-link nav-link-sm nav-dropdown-toggle"
                        data-dropdown-target="button"
                        data-action="click->dropdown#toggle"
                        aria-expanded="false"
                        aria-haspopup="true">
                  <span>Bible</span>
                  <span class="nav-dropdown-caret" aria-hidden="true"></span>
                </button>
                <div class="nav-dropdown-menu" data-dropdown-target="menu" hidden>
                  <%= link_to "Browse Bible", bible_verses_books_path, class: "nav-dropdown-item" %>
                  <%= link_to "Daily Readings", daily_readings_path, class: "nav-dropdown-heading" %>
                  <% nav_daily_reading_links.each do |link| %>
                    <%= link_to link[:label], link[:path], class: "nav-dropdown-item nav-dropdown-item-nested" %>
                  <% end %>
                </div>
              </div>
            </li>
            <li class="nav-item">
              <div class="nav-dropdown" data-controller="dropdown">
                <button type="button"
                        class="nav-link nav-link-sm nav-dropdown-toggle"
                        data-dropdown-target="button"
                        data-action="click->dropdown#toggle"
                        aria-expanded="false"
                        aria-haspopup="true">
                  <span>Study</span>
                  <span class="nav-dropdown-caret" aria-hidden="true"></span>
                </button>
                <div class="nav-dropdown-menu" data-dropdown-target="menu" hidden>
                  <%= link_to "Notes", notes_path, class: "nav-dropdown-item" %>
                  <%= link_to "Topics", topics_path, class: "nav-dropdown-item" %>
                  <%= link_to "Threads", bible_threads_path, class: "nav-dropdown-item" %>
                  <%= link_to "Chiasms", chiasms_path, class: "nav-dropdown-item" %>
                </div>
              </div>
            </li>
            <li class="nav-item">
              <%= link_to search_path, class: "nav-link nav-link-sm" do %>
                Search
              <% end %>
            </li>
          <% end %>
        </ul>
        
        <div class="nav-actions nav-actions-desktop">
          <% if user_signed_in? %>
            <%
              content_review_count = current_user.flagged_content_needing_review_count
              admin_pending_count = current_user.can_manage_users? ? ContentFlag.status_pending.count : 0
              unread_notifications_count = current_user.unread_notifications_count
              total_alert_count = content_review_count + admin_pending_count + unread_notifications_count
              display_name = current_user.name.presence || current_user.email
            %>
            <span class="user-info">
              <span class="role-badge <%= current_user.role %>"><%= current_user.role&.titleize || 'Viewer' %></span>
            </span>
            <div class="nav-dropdown" data-controller="dropdown">
              <button type="button"
                      class="nav-dropdown-toggle btn btn-outline"
                      data-dropdown-target="button"
                      data-action="click->dropdown#toggle"
                      aria-expanded="false"
                      aria-haspopup="true">
                <span class="nav-dropdown-label"><%= display_name %></span>
                <% if total_alert_count > 0 %>
                  <span class="badge badge-warning nav-dropdown-alert"><%= total_alert_count %></span>
                <% end %>
                <span class="nav-dropdown-caret" aria-hidden="true"></span>
              </button>
              <div class="nav-dropdown-menu" data-dropdown-target="menu" hidden>
                <%= link_to notifications_path, class: "nav-dropdown-item" do %>
                  <span>Notifications</span>
                  <% if unread_notifications_count > 0 %>
                    <span class="badge badge-warning"><%= unread_notifications_count %></span>
                  <% end %>
                <% end %>
                <%= link_to my_flagged_content_path, class: "nav-dropdown-item" do %>
                  <span>My Content</span>
                  <% if content_review_count > 0 %>
                    <span class="badge badge-warning"><%= content_review_count %></span>
                  <% end %>
                <% end %>
                <%= link_to new_bulk_upload_path, class: "nav-dropdown-item" do %>
                  <span>Bulk Upload</span>
                <% end %>
                <% if current_user.can_manage_users? %>
                  <%= link_to admin_users_path, class: "nav-dropdown-item" do %>
                    <span>Admin</span>
                    <% if admin_pending_count > 0 %>
                      <span class="badge badge-warning"><%= admin_pending_count %></span>
                    <% end %>
                  <% end %>
                <% end %>
                <%= link_to "Profile", edit_user_registration_path, class: "nav-dropdown-item" %>
                <div class="nav-dropdown-divider" role="separator"></div>
                <%= button_to "Log out",
                    destroy_user_session_path,
                    method: :delete,
                    class: "nav-dropdown-item nav-dropdown-item-button",
                    form: { class: "nav-dropdown-form" },
                    data: { turbo: false, confirm: "Are you sure you want to log out?" } %>
              </div>
            </div>
          <% else %>
            <%= link_to 'Log In', new_user_session_path, class: 'btn btn-outline' %>
            <%= link_to 'Sign Up', new_user_registration_path, class: 'btn btn-primary' %>
          <% end %>
        </div>

        <!-- Hamburger Button -->
        <button class="hamburger" data-mobile-nav-target="hamburger" data-action="click->mobile-nav#toggle" type="button" aria-label="Toggle menu">
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
        </button>

        <!-- Mobile Menu -->
        <div class="nav-menu-mobile" data-mobile-nav-target="menu">
          <ul class="mobile-nav-links">
            <li class="mobile-nav-item">
              <a href="/" class="mobile-nav-link" data-action="click->mobile-nav#closeMenu">Home</a>
            </li>
            <% if user_signed_in? %>
              <li class="mobile-nav-group">
                <div class="mobile-nav-group-label">Bible</div>
                <%= link_to "Browse Bible", bible_verses_books_path, class: "mobile-nav-link mobile-nav-link-nested", data: { action: "click->mobile-nav#closeMenu" } %>
                <%= link_to "Daily Readings", daily_readings_path, class: "mobile-nav-link mobile-nav-link-nested", data: { action: "click->mobile-nav#closeMenu" } %>
                <% nav_daily_reading_links.each do |link| %>
                  <%= link_to link[:label], link[:path], class: "mobile-nav-link mobile-nav-link-nested", data: { action: "click->mobile-nav#closeMenu" } %>
                <% end %>
              </li>
              <li class="mobile-nav-group">
                <div class="mobile-nav-group-label">Study</div>
                <%= link_to "Notes", notes_path, class: "mobile-nav-link mobile-nav-link-nested", data: { action: "click->mobile-nav#closeMenu" } %>
                <%= link_to "Topics", topics_path, class: "mobile-nav-link mobile-nav-link-nested", data: { action: "click->mobile-nav#closeMenu" } %>
                <%= link_to "Threads", bible_threads_path, class: "mobile-nav-link mobile-nav-link-nested", data: { action: "click->mobile-nav#closeMenu" } %>
                <%= link_to "Chiasms", chiasms_path, class: "mobile-nav-link mobile-nav-link-nested", data: { action: "click->mobile-nav#closeMenu" } %>
              </li>
              <li class="mobile-nav-item">
                <%= link_to search_path, class: "mobile-nav-link", data: { action: "click->mobile-nav#closeMenu" } do %>
                  Search
                <% end %>
              </li>
            <% end %>
          </ul>

          <div class="mobile-nav-actions">
            <% if user_signed_in? %>
              <%
                content_review_count = current_user.flagged_content_needing_review_count
                admin_pending_count = current_user.can_manage_users? ? ContentFlag.status_pending.count : 0
                unread_notifications_count = current_user.unread_notifications_count
                display_name = current_user.name.presence || current_user.email
              %>
              <div class="mobile-user-info">
                <div class="mobile-user-email"><%= display_name %></div>
                <span class="role-badge <%= current_user.role %>"><%= current_user.role&.titleize || 'Viewer' %></span>
              </div>
              <%= link_to notifications_path, class: "btn btn-outline btn-block mobile-nav-action-link", data: { action: "click->mobile-nav#closeMenu" } do %>
                <span>Notifications</span>
                <% if unread_notifications_count > 0 %>
                  <span class="badge badge-warning"><%= unread_notifications_count %></span>
                <% end %>
              <% end %>
              <%= link_to my_flagged_content_path, class: "btn btn-outline btn-block mobile-nav-action-link", data: { action: "click->mobile-nav#closeMenu" } do %>
                <span>My Content</span>
                <% if content_review_count > 0 %>
                  <span class="badge badge-warning"><%= content_review_count %></span>
                <% end %>
              <% end %>
              <% if current_user.can_manage_users? %>
                <%= link_to admin_users_path, class: "btn btn-outline btn-block mobile-nav-action-link", data: { action: "click->mobile-nav#closeMenu" } do %>
                  <span>Admin</span>
                  <% if admin_pending_count > 0 %>
                    <span class="badge badge-warning"><%= admin_pending_count %></span>
                  <% end %>
                <% end %>
              <% end %>
              <%= link_to 'Profile', edit_user_registration_path, class: 'btn btn-outline btn-block', data: { action: "click->mobile-nav#closeMenu" } %>
              <%= button_to 'Log out', destroy_user_session_path, method: :delete, class: 'btn btn-outline btn-block', data: { turbo: false, confirm: 'Are you sure you want to log out?', action: "click->mobile-nav#closeMenu" } %>
            <% else %>
              <%= link_to 'Log In', new_user_session_path, class: 'btn btn-outline btn-block', data: { action: "click->mobile-nav#closeMenu" } %>
              <%= link_to 'Sign Up', new_user_registration_path, class: 'btn btn-primary btn-block', data: { action: "click->mobile-nav#closeMenu" } %>
            <% end %>
          </div>
        </div>
      </div>
    </nav>
    
    <main class="main-content">
      <div class="container">
        <% if notice.present? %>
          <div class="alert alert-success" role="status"><%= notice %></div>
        <% end %>
        <% if alert.present? %>
          <div class="alert alert-danger" role="alert"><%= alert %></div>
        <% end %>
        <%= yield %>
      </div>
    </main>

    <footer class="site-footer">
      <div class="site-footer-inner">
        <nav class="site-footer-links" aria-label="Features">
          <%= link_to "Notes", notes_path, class: "site-footer-link" %>
          <%= link_to "Bible", bible_verses_books_path, class: "site-footer-link" %>
          <%= link_to "Topics", topics_path, class: "site-footer-link" %>
          <%= link_to "Threads", bible_threads_path, class: "site-footer-link" %>
          <%= link_to "Chiasms", chiasms_path, class: "site-footer-link" %>
          <%= link_to "Search", search_path, class: "site-footer-link" %>
        </nav>

        <% if user_signed_in? %>
          <p class="site-footer-contact">
            For questions, ideas or issues, contact
            <%= mail_to "christadelphiancompendium@gmail.com", "christadelphiancompendium@gmail.com", class: "site-footer-email" %>.
          </p>
        <% end %>
      </div>
    </footer>
    
    <%= turbo_frame_tag "modal" %>
  </body>
</html>
