<div class="onboarding-container">
  <div class="onboarding-card">
    <% if @onboarding_type == "admin" %>
      <div class="onboarding-header">
        <div class="onboarding-header-icon" aria-hidden="true">
          <i class="fa-solid fa-crown"></i>
        </div>
        <h1 class="onboarding-title">Welcome to Admin!</h1>
        <p class="onboarding-subtitle">You've been promoted to administrator. Here's what you can do now.</p>
      </div>

      <div class="onboarding-body">
        <div class="onboarding-feature-grid">
          <div class="onboarding-feature">
            <div class="onboarding-feature-icon">
              <i class="fa-solid fa-users"></i>
            </div>
            <h3 class="onboarding-feature-title">User Management</h3>
            <p class="onboarding-feature-description">
              View, edit, and manage all users. Change user roles, promote contributors,
              and remove spam accounts from the admin dashboard.
            </p>
          </div>

          <div class="onboarding-feature">
            <div class="onboarding-feature-icon">
              <i class="fa-solid fa-shield-halved"></i>
            </div>
            <h3 class="onboarding-feature-title">Full Content Access</h3>
            <p class="onboarding-feature-description">
              Edit or delete any user's notes, comments, and cross-references.
              You have complete control over all content in the system.
            </p>
          </div>

          <div class="onboarding-feature">
            <div class="onboarding-feature-icon">
              <i class="fa-solid fa-flag"></i>
            </div>
            <h3 class="onboarding-feature-title">Content Moderation</h3>
            <p class="onboarding-feature-description">
              Review and manage flagged content from all users. Approve, request changes,
              or remove inappropriate content to maintain quality.
            </p>
          </div>

          <div class="onboarding-feature">
            <div class="onboarding-feature-icon">
              <i class="fa-solid fa-user-shield"></i>
            </div>
            <h3 class="onboarding-feature-title">Role Assignment</h3>
            <p class="onboarding-feature-description">
              Promote viewers to contributors when they're ready to create content,
              or elevate trusted users to admin status.
            </p>
          </div>
        </div>

        <div class="onboarding-tips">
          <h3 class="onboarding-tips-title">
            <i class="fa-solid fa-lightbulb"></i>
            Quick Tips
          </h3>
          <ul class="onboarding-tips-list">
            <li>Access the Admin Dashboard from the navigation bar</li>
            <li>Use role filters to quickly find users by their access level</li>
            <li>The "Admin" badge will appear next to your name throughout the app</li>
            <li>You can still review content flagged on your own posts in "My Content"</li>
          </ul>
        </div>
      </div>

      <div class="onboarding-footer">
        <%= form_with url: skip_onboarding_path, method: :post do %>
          <%= hidden_field_tag :type, "admin" %>
          <%= button_tag type: "submit", class: "btn btn-outline" do %>
            Skip for now
          <% end %>
        <% end %>
        <%= form_with url: complete_onboarding_path, method: :post do %>
          <%= hidden_field_tag :type, "admin" %>
          <%= button_tag type: "submit", class: "btn btn-primary" do %>
            <i class="fa-solid fa-rocket"></i>
            Go to Admin Dashboard
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="onboarding-wizard" data-controller="onboarding">
        <div class="onboarding-wizard-top">
          <p class="onboarding-counter" data-onboarding-target="counter">Step 1 of <%= @steps.size %></p>
          <div class="onboarding-progress" role="tablist" aria-label="Onboarding progress">
            <% @steps.each_with_index do |_step, index| %>
              <button type="button"
                      class="onboarding-dot<%= " is-active" if index.zero? %>"
                      data-onboarding-target="dot"
                      data-step-index="<%= index %>"
                      data-action="click->onboarding#goTo"
                      aria-label="Go to step <%= index + 1 %>"
                      aria-current="<%= index.zero? ? "step" : "false" %>"></button>
            <% end %>
          </div>
        </div>

        <div class="onboarding-steps">
          <% @steps.each_with_index do |step, index| %>
            <div class="onboarding-step<%= " is-active" if index.zero? %>"
                 data-onboarding-target="step"
                 data-step-key="<%= step[:key] %>"
                 <%= "hidden" unless index.zero? %>>
              <div class="onboarding-step-header">
                <div class="onboarding-step-icon" aria-hidden="true">
                  <i class="fa-solid <%= step[:icon] %>"></i>
                </div>
                <h1 class="onboarding-title"><%= step[:title] %></h1>
                <p class="onboarding-subtitle"><%= step[:body] %></p>
              </div>

              <% if step[:screenshot].present? %>
                <div class="onboarding-screenshot">
                  <%= image_tag step[:screenshot],
                        alt: "#{step[:title]} screenshot",
                        class: "onboarding-screenshot-image" %>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>

        <div class="onboarding-footer onboarding-footer-wizard">
          <button type="button"
                  class="btn btn-outline"
                  data-onboarding-target="prev"
                  data-action="click->onboarding#previous"
                  disabled>
            <i class="fa-solid fa-arrow-left"></i>
            Back
          </button>

          <div class="onboarding-footer-actions">
            <%= form_with url: skip_onboarding_path, method: :post do %>
              <%= hidden_field_tag :type, "user" %>
              <%= button_tag type: "submit", class: "btn btn-outline" do %>
                Skip tour
              <% end %>
            <% end %>

            <button type="button"
                    class="btn btn-primary"
                    data-onboarding-target="next"
                    data-action="click->onboarding#next">
              Next
              <i class="fa-solid fa-arrow-right"></i>
            </button>

            <div data-onboarding-target="finish" hidden>
              <%= form_with url: complete_onboarding_path, method: :post do %>
                <%= hidden_field_tag :type, "user" %>
                <%= button_tag type: "submit", class: "btn btn-primary" do %>
                  <i class="fa-solid fa-rocket"></i>
                  Get Started
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
