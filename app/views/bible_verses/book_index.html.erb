<div class="page-header">
  <h1 class="page-title">The King James Version</h1>
  <p class="page-subtitle">Browse the complete Bible by book and chapter</p>
</div>

<div class="bible-browse-toolbar">
  <% if current_user&.can_create? %>
    <%= link_to bulk_upload_hub_path, class: "btn btn-outline" do %>
      Bulk Upload
    <% end %>
  <% end %>

  <div class="bible-search-group form-group" data-controller="bible-search">
    <label class="form-label">Search Bible</label>
    <div class="relative">
      <input 
        type="text" 
        class="form-input" 
        placeholder="Type to search (e.g., Genesis, John 3, Romans 8:1)"
        autocomplete="off"
        data-bible-search-target="input"
        data-action="input->bible-search#search keydown->bible-search#handleKeydown" />
      <div 
        class="absolute z-10 w-full mt-1 bg-white border border-gray-300 rounded-md shadow-lg hidden"
        data-bible-search-target="dropdown">
        <ul class="max-h-60 overflow-auto py-1 list-none m-0 p-0" data-bible-search-target="results">
          <!-- Results will be populated here -->
        </ul>
      </div>
    </div>
    <small class="form-help">Start typing to see books, chapters, or verses</small>
  </div>
</div>

<div class="content-section">
  <div class="section-header">
    <h2 class="section-title">Bible Books</h2>
  </div>
  
  <div class="section-content">
    <div class="bible-testaments">
      <!-- Old Testament -->
      <div class="testament-section">
        <h3 class="text-xl font-semibold text-gray-800 mb-4 pb-2 border-b-2 border-gray-200">
          Old Testament
        </h3>
        <div class="books-grid">
          <% @old_testament_books.each do |book| %>
            <%= link_to book.book, bible_verse_chapters_path(book: book.book), 
                class: "book-link" %>
          <% end %>
        </div>
      </div>
      
      <!-- New Testament -->
      <div class="testament-section">
        <h3 class="text-xl font-semibold text-gray-800 mb-4 pb-2 border-b-2 border-gray-200">
          New Testament
        </h3>
        <div class="books-grid">
          <% @new_testament_books.each do |book| %>
            <%= link_to book.book, bible_verse_chapters_path(book: book.book), 
                class: "book-link" %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>