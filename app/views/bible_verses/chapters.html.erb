<div class="page-header">
  <h1 class="page-title"><%= @book %></h1>
  <p class="page-subtitle">Select a chapter to read</p>
</div>

<div class="content-section">
  <div class="section-header">
    <div class="bible-section-actions">
      <h2 class="section-title">Chapters</h2>
      <%= link_to "← Bible", bible_verses_books_path, class: "btn btn-outline" %>
    </div>
  </div>

  <div class="section-content">
    <div class="chapters-grid">
      <% @chapters.each do |chapter| %>
        <%= link_to chapter.chapter, bible_verse_verses_path(book: @book, chapter: chapter.chapter), 
            class: "chapter-link" %>
      <% end %>
    </div>
  </div>

  <% if current_user&.can_create? || @book_level_comments.any? %>
    <div class="section-content coverage-comments-wrap mt-6">
      <%= render "comments/coverage_section",
            title: "Comments on #{@book}",
            comments: @book_level_comments,
            children_by_parent: @book_level_children,
            page_verse: @first_verse,
            empty_message: "No book-level comments yet.",
            add_path: (@first_verse && current_user&.can_create?) ? new_bible_verse_comment_path(book: @book, chapter: @first_verse.chapter, verse: @first_verse.verse, coverage: Comment::COVERAGE_BOOK, return_to: "book") : nil,
            add_label: "Add book comment" %>
    </div>
  <% end %>
</div> 