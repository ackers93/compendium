<div class="page-header">
  <h1 class="page-title">Edit Chiasm</h1>
  <p class="page-subtitle">
    <%= @chiasm.range_reference %> — highlight text in the passage to add limbs
  </p>
</div>

<div class="content-section">
  <%= render 'limbs_form', chiasm: @chiasm %>

  <div class="d-flex justify-between mt-6">
    <%= link_to "← Cancel", chiasm_path(@chiasm), class: "btn btn-outline" %>
  </div>
</div>
