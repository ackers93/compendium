<%= turbo_frame_tag "cross-reference-comments-search-results" do %>
  <% if @comments.any? %>
    <div class="content-section">
      <div class="section-header">
        <h2 class="section-title">Comments on Cross References</h2>
      </div>
      <div class="section-content">
        <div class="comments-list">
          <% @comments.each do |comment| %>
            <% cross_ref = comment.commentable %>
            <div class="comment-item mb-4 p-4 bg-gray-50 rounded">
              <div class="comment-header text-xs text-gray-500 mb-2">
                <span class="author-name">
                  <%= comment.user&.display_name || "Unknown User" %>
                </span>
                <span class="comment-date">
                  • <%= time_ago_in_words(comment.created_at) %> ago
                </span>
                <span class="ml-2">
                  • Comment on cross-reference:
                  <%= link_to cross_ref.source_verse.reference,
                      bible_verse_show_path(book: cross_ref.source_verse.book, chapter: cross_ref.source_verse.chapter, verse: cross_ref.source_verse.verse),
                      class: "text-blue-600 hover:text-blue-800",
                      data: { turbo_frame: "_top" } %>
                  ↔
                  <%= link_to cross_ref.target_reference,
                      bible_verse_show_path(book: cross_ref.target_verse.book, chapter: cross_ref.target_verse.chapter, verse: cross_ref.target_verse.verse),
                      class: "text-blue-600 hover:text-blue-800",
                      data: { turbo_frame: "_top" } %>
                </span>
              </div>
              <div class="comment-content">
                <%= comment.content %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
<% end %>
